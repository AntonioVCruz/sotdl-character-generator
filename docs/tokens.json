{
  "$description": "SotDL Character Generator — design tokens (W3C DTCG). Identity A: ink and blood. Source of truth for docs/design.md.",
  "color": {
    "$type": "color",
    "text": {
      "default": { "$value": "#1A1A18", "$description": "Headings, body, values" },
      "secondary": { "$value": "#4F4F4B", "$description": "Supporting text, labels" },
      "muted": { "$value": "#65645E", "$description": "Metadata, origin lines, placeholders; min 4.5:1 on every background" },
      "inverse": { "$value": "#FFFFFF", "$description": "Text on ink or accent fills" }
    },
    "background": {
      "page": { "$value": "#F2EFE9", "$description": "App background (parchment)" },
      "surface": { "$value": "#FFFFFF", "$description": "Cards, panels, dialogs" },
      "subtle": { "$value": "#F7F6F2", "$description": "Header bar, quiet blocks" },
      "sunken": { "$value": "#ECE9E2", "$description": "Composition box, waiting cards, disabled fields" }
    },
    "border": {
      "divider": { "$value": "#D4D4CF", "$description": "Decorative separators and card outlines only; never the only boundary of a control" },
      "control": { "$value": "#85847E", "$description": "Inputs, outline buttons, dashed pending boxes; min 3:1" },
      "strong": { "$value": "#1A1A18", "$description": "Selected card (2px), active segment" }
    },
    "action": {
      "primary": { "$value": "{color.text.default}", "$description": "Primary button fill (Next, Roll, Apply)" },
      "primary-hover": { "$value": "#33332F" },
      "selected": { "$value": "{color.text.default}", "$description": "Selected segment, current step in the map" }
    },
    "accent": {
      "default": { "$value": "#8E1B1B", "$description": "Identity red: step eyebrow and rule, brand mark, rule-triggered border, danger" },
      "hover": { "$value": "#6F1414" },
      "tint": { "$value": "#F6E7E5", "$description": "Background for danger and rule-triggered blocks" }
    },
    "state": {
      "danger": { "$value": "{color.accent.default}" },
      "danger-tint": { "$value": "{color.accent.tint}" },
      "success": { "$value": "#2E6B30" },
      "success-tint": { "$value": "#E8F1E8" },
      "warning": { "$value": "#8A5A00" },
      "warning-tint": { "$value": "#F7EEDA" }
    },
    "focus": { "$value": "#1F5FBF", "$description": "Focus ring, always with 2px offset" },
    "overlay": { "$value": "#1A1A1880", "$description": "Dialog backdrop (ink at 50%)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Spectral", "Georgia", "serif"] },
      "body": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "13px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "18px" },
      "2xl": { "$value": "22px" },
      "3xl": { "$value": "28px" },
      "4xl": { "$value": "40px" },
      "display-mobile": { "$value": "24px", "$description": "display style below breakpoint.md" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.45 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "eyebrow": { "$value": "0.06em" }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "heading": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "title": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "title-sm": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "0" } },
    "body-lg": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "0" } },
    "label": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "meta": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "0" } },
    "caption": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "0" } },
    "eyebrow": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.eyebrow}" } },
    "stat": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "stat-lg": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } },
    "stat-sm": { "$value": { "fontFamily": "{font.family.body}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" }, "$description": "Attribute value in live-summary mini-cards; tabular figures" },
    "badge": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "0" } }
  },
  "space": {
    "$type": "dimension",
    "0-5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "8px" },
    "pill": { "$value": "999px" }
  },
  "border-width": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "selected": { "$value": "2px" },
    "focus": { "$value": "2px" },
    "indicator": { "$value": "3px", "$description": "Current-step bar in step-map" },
    "alert": { "$value": "4px", "$description": "Left border of inline-alert" }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": { "$value": { "color": "#1A1A182E", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, "$description": "Dialogs, popovers and menus only; cards are flat" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "40px", "$description": "Button, input, segment height (fine pointer)" },
    "control-sm": { "$value": "32px", "$description": "Compact controls inside cards (fine pointer only)" },
    "touch-target": { "$value": "44px", "$description": "Minimum target on coarse pointer" },
    "step-map": { "$value": "232px" },
    "summary": { "$value": "280px" },
    "content-max": { "$value": "1440px" },
    "prose-max": { "$value": "72ch" },
    "dialog-max": { "$value": "760px" },
    "header": { "$value": "64px", "$description": "App header height from breakpoint.md up" },
    "header-mobile": { "$value": "56px", "$description": "App header height below breakpoint.md" },
    "sheet-aside": { "$value": "320px", "$description": "Sheet right column (desktop)" },
    "pill": { "$value": "24px", "$description": "pill-counter height" },
    "icon-sm": { "$value": "16px", "$description": "Icon in controls, badges and inline text; button spinner" },
    "icon-md": { "$value": "20px", "$description": "Icon in headers and alerts" }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.45, "$description": "Disabled control, always with the reason in text when one exists" }
  },
  "icon": {
    "stroke": { "$type": "number", "$value": 1.5, "$description": "Lucide stroke width" }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px", "$description": "Below: mobile layout (SCR-WEB-016, SCR-WEB-021)" },
    "xl": { "$value": "1280px", "$description": "From here: three-zone builder" }
  }
}
